# ---------------------------------------------------------------------------
# GRANIT EU Data Scraper - Environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed.
# Never commit real credentials to version control.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=GRANIT EU Data Manager
APP_ENV=development
DEBUG=true

# --- MongoDB ---
# Do not hardcode credentials here. Provide the full connection URI instead.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=granit_eu

# --- Logging ---
LOG_LEVEL=INFO

# --- Scraping / export limits ---
MAX_PRODUCT_RECORDS=100
HTTP_REQUEST_TIMEOUT=30
